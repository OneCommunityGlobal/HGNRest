# HGNRest environment template (from README + emailSender OAuth used in production/blue-square)
# Copy to .env and fill values. Never commit .env.

# --- Database (MongoDB Atlas) ---
user=<user>
password=<password>
cluster=<clustername>
dbName=<dbname>
appName=<appName>
replicaSetName=<replicaSet>

# --- Monitoring ---
SentryDSN_URL=<SentryURL>

# --- Auth ---
TOKEN_LIFETIME=<number>
TOKEN_LIFETIME_UNITS=<unit like days, second, hours etc>
JWT_SECRET=<secret value>
DEF_PWD=<default password>
NODE_ENV=local

# --- Optional SMTP (local fallback only; production uses OAuth below) ---
SMTPDomain=smtp.gmail.com
SMTPPort=465
SMTPUser=<smtp user>
SMTPPass=<smtp user password>

# --- Time archive seed user ---
TIME_ARCHIVE_FIRST_NAME=TimeArchiveAccount
TIME_ARCHIVE_LAST_NAME=TimeArchiveAccount
TIME_ARCHIVE_EMAIL=TimeArchiveAccount@yopmail.com

# --- Enable outbound email (required for blue-square + job applications) ---
sendEmail=true

# --- Gmail OAuth (REQUIRED for production-like sending; same as blue-square / weekly summary) ---
# Get these from Azure App Settings for HGNRest, or a teammate who already runs blue-square email locally.
REACT_APP_EMAIL=<gmail account used by the app, usually onecommunityglobal@gmail.com>
REACT_APP_EMAIL_CLIENT_ID=<Google OAuth client id>
REACT_APP_EMAIL_CLIENT_SECRET=<Google OAuth client secret>
REACT_APP_EMAIL_CLIENT_REDIRECT_URI=<OAuth redirect URI>
REACT_APP_EMAIL_REFRESH_TOKEN=<OAuth refresh token>

# --- Job application staff inbox (optional override; default in code is onecommunityglobal@gmail.com) ---
# JOB_APPLICATION_DEFAULT_EMAIL=onecommunityglobal@gmail.com
